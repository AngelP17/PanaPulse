DATABASE_URL=sqlite:////data/panapulse.db
PANAPULSE_CORS_ORIGINS=
# Trust only the actual host proxy's source IP (see runbook). Never set '*'.
FORWARDED_ALLOW_IPS=127.0.0.1
# Turn on after configuring the hash key and privacy/release review.
PANAPULSE_REPORTS_ENABLED=0
PANAPULSE_REPORT_HASH_KEY=
# Optional provider collectors. Public-page feasibility is not proof of data reuse permission.
PANAPULSE_UTILITY_SOURCES=ensa,naturgy
# Leave optional model-backed Ask disabled until provider smoke + spending cap are verified.
# The current in-process model budget resets on restart; it is not a durable spending limit.
ANTHROPIC_API_KEY=
PANAPULSE_ASK_GLOBAL_PER_DAY=100
