{
  "expo": {
    "name": "PanaPulse",
    "slug": "panapulse",
    "version": "0.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.panapulse.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#102635",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "app.panapulse.mobile"
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      "expo-font"
    ],
    "scheme": "panapulse"
  }
}
